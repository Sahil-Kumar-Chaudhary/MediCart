# MediCart Backend Environment Configuration Template

# Server Port (Render provides this dynamically via process.env.PORT)
PORT=5000

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=development

# MongoDB Connection String
# For Local Dev: mongodb://localhost:27017/medicart
# For Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medicart?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medicart

# JWT Configuration
JWT_SECRET=medicart_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Authentication & Demonstration Mode
# 'DEMO' | 'PRODUCTION'
OTP_MODE=DEMO
DEMO_PHONE_NUMBER=9876543210
DEMO_OTP_CODE=487210
